generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  address   String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  ratings   Rating[]
  store     Store?
}

model Store {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  address   String
  ownerId   Int      @unique
  createdAt DateTime @default(now())

  owner     User     @relation(fields: [ownerId], references: [id])
  ratings   Rating[]
}

model Rating {
  id        Int      @id @default(autoincrement())
  value     Int
  userId    Int
  storeId   Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  store     Store    @relation(fields: [storeId], references: [id])

  @@unique([userId, storeId])
}

enum Role {
  ADMIN
  USER
  STORE_OWNER
}
